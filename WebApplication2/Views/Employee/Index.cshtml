@using WebApplication2.Models.Models
@model IEnumerable<Employee>

<h2>Employees</h2>

<a asp-action="Create">Create New</a>

<table class="table">
    <tr>
        <th>Name</th>
        <th>DepartmentId</th>
    </tr>

@foreach (var item in Model)
{
    <tr>
        <td>@item.Name</td>
        <td>@item.DepartmentId</td>
    </tr>
}
</table>