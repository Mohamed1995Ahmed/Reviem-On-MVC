@using WebApplication2.Models.Models
@model IEnumerable<Employee>

<h2>Employees</h2>

<a asp-action="Create">Create New</a>

<table class="table">
    <tr>
        <th>Name</th>
        <th>DepartmentId</th>
        <th>Image</th>
        <th>Actions</th>
        

    </tr>

@foreach (var item in Model)
{
    <tr>
        <td>@item.Name</td>
        <td>@item.DepartmentId</td>
            @* <td>
                <img src="@item.Image" width="80" height="20" />

            </td> *@
            <td>
                <img src="@item.Image" width="80" height="80" />

                <a asp-action="DownloadImage"
                   asp-route-id="@item.Id"
                   class="btn btn-success btn-sm">
                    Download
                </a>
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Edit</a>

                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>

                <a asp-action="DownloadImage" asp-route-id="@item.Id" class="btn btn-success btn-sm">
                    Download
                </a>
            </td>
    </tr>
}
</table>